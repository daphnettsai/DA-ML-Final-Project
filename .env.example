# Copy to .env for local development. Never commit .env.
# Leave YELP_API_KEY empty to run in local-only fallback mode.
YELP_API_KEY=your-yelp-api-key-here

# Stop calling Yelp after this many calls per day (trial cap is about 5,000 total).
YELP_DAILY_CALL_LIMIT=300

# SQLite file for development (gitignored).
DATABASE_PATH=data/restaurants.sqlite
